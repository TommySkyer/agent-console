{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // vite/client 提供 import.meta.env 和 *.css 副作用导入的声明；
    // node 供 vite.config.ts 与测试里读 fixture 文件使用。
    "types": ["vitest/globals", "@testing-library/jest-dom", "vite/client", "node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,

    // TS 7 移除了 baseUrl；paths 现在直接相对 tsconfig 所在目录解析。
    // 注意这里只影响类型检查，真正的模块解析由 Vite 做，
    // 所以 vite.config.ts 的 resolve.alias 必须写一份一样的。
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
